            {
              "type": "element",
              "tag": "strong",
              "attributes": {},
              "variant": null,
              "children": [
                {
                  "type": "text",
                  "text": "AEO and GEO readiness."
                }
              ]
            },
            {
              "type": "text",
              "text": " Answer Engine Optimization and Generative Engine Optimization decide whether your brand gets cited inside AI summaries and chat answers. A modern agency structures content to be quoted by these engines, not just to rank in blue links."
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "tag": "li",
          "attributes": {},
