            {
              "type": "element",
              "tag": "strong",
              "attributes": {},
              "variant": null,
              "children": [
                {
                  "type": "text",
                  "text": "Technical SEO strength."
                }
              ]
            },
            {
              "type": "text",
              "text": " Rankings favour technically clean sites with fast load times, healthy Core Web Vitals, correct indexing, and structured data. Ask how the agency audits and fixes technical issues, and whether they use schema markup to help engines understand your pages."
            }
          ]
        },
        {
          "type": "text",
          "text": "\n"
        },
        {
          "type": "element",
          "tag": "li",
          "attributes": {},
