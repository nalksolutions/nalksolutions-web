# Fixture mode is deliberately unavailable when APP_ENV=production.
APP_ENV=local
# Optional server-only override; the test harness sets an isolated copy.
# FIXTURE_CONTENT_PATH=tmp/my-fixtures.json
# Optional paired directory for isolated content-body tests.
# FIXTURE_DOCUMENTS_PATH=tmp/my-documents

# Optional developer-only access to unpublished translation drafts. Not required for Arabic pages.
# ARABIC_REVIEW_MODE=1

# Contact delivery: server-only credentials. No database is used.
# Set a verified sender address and the intended recipient in Vercel and .env.local.
CONTACT_EMAIL_MODE=resend
# RESEND_API_KEY=
# CONTACT_EMAIL_FROM=forms@notify.nalksolutions.com
CONTACT_EMAIL_TO=info@nalksolutions.com
# Turnstile is disabled by default, including on Vercel. Keys are ignored while disabled.
CONTACT_TURNSTILE_ENABLED=false
# To re-enable later, set CONTACT_TURNSTILE_ENABLED=true and provide both keys.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key
# TURNSTILE_SECRET_KEY=your_secret_key
# Optional additional exact HTTPS origins, comma separated (no trailing slash).
# CONTACT_ALLOWED_ORIGINS=https://your-owned-preview.example
# VERCEL_URL, VERCEL_BRANCH_URL and VERCEL_PROJECT_PRODUCTION_URL are allowed exactly.
# The owned https://nalksolutions-web.vercel.app project alias is also allowed.
# Never set CONTACT_EMAIL_MODE=test on a hosted deployment.
